<?xml version="1.0" encoding="utf-8"?>
<!-- Splash animation (about 1 s):
     1. a soft ring draws itself around the centre,
     2. the stem of the "i" grows up from the bottom,
     3. the dot drops in and bounces.
     Uses the same 108 x 108 grid as the launcher icon. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp" android:height="108dp"
            android:viewportWidth="108" android:viewportHeight="108">

            <path
                android:name="ring"
                android:pathData="M54,22 a32,32 0 1,1 -0.01,0"
                android:strokeColor="#FFF9A8D4"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />

            <group android:name="stem" android:pivotX="54" android:pivotY="78" android:scaleY="0">
                <path android:fillColor="#FFFFFFFF" android:pathData="M48,44h12v34a6,6 0,0 1,-12 0z" />
            </group>

            <group android:name="dot" android:translateY="-46">
                <path android:fillColor="#FFFFFFFF"
                    android:pathData="M54,30m-6.5,0a6.5,6.5 0,1 1,13 0a6.5,6.5 0,1 1,-13 0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:duration="700"
                android:valueFrom="0" android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="stem">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:startOffset="150"
                android:duration="450"
                android:valueFrom="0" android:valueTo="1"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot" />
        </aapt:attr>
    </target>

    <target android:name="dot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:startOffset="450"
                android:duration="550"
                android:valueFrom="-46" android:valueTo="0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/bounce" />
        </aapt:attr>
    </target>
</animated-vector>

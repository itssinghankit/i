<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#EDE9FE" /><corners android:radius="99dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape>
            <gradient android:startColor="#7C3AED" android:centerColor="#EC4899" android:endColor="#F97316" android:angle="0" />
            <corners android:radius="99dp" />
        </shape></clip>
    </item>
</layer-list>
